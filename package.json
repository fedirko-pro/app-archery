{
  "name": "sokil",
  "version": "0.1.10",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @sokil/shared-types build && pnpm --parallel --filter @sokil/web --filter @sokil/api dev",
    "dev:web": "pnpm --filter @sokil/web dev",
    "dev:api": "pnpm --filter @sokil/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter @sokil/shared-types build && pnpm -r lint && biome check .",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run",
    "typecheck": "pnpm --filter @sokil/web typecheck && pnpm --filter @sokil/api typecheck",
    "audit:ci": "pnpm audit --audit-level=high",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write"
    ],
    "*.scss": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@turbo/windows-64": "2.10.1"
  }
}
